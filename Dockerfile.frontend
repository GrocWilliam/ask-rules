# syntax=docker/dockerfile:1

FROM docker.io/library/node:24-slim AS builder
WORKDIR /workspace

RUN npm install -g pnpm@10 --no-update-notifier --quiet
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY svelte.config.js vite.config.mts tsconfig.json tsconfig.node.json ./
COPY src ./src
COPY static ./static

RUN pnpm run build:web

FROM docker.io/library/nginx:1.29-alpine
ENV ENV=production \
    NGINX_PORT=80 \
    BACKEND_HOST=backend \
    BACKEND_PORT=8080 \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

COPY deploy/nginx/default.conf /etc/nginx/templates/default.conf.template
COPY --from=builder /workspace/build /usr/share/nginx/html

EXPOSE 80
