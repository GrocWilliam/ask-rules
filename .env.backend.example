ENV=production
PORT=8080
DATABASE_URL=postgresql://user:password@db:5432/ask_rules
MISTRAL_API_KEY=
# Plugsky : secours si Mistral échoue (quota, panne)
PLUGSKY_API_KEY=
PLUGSKY_MODEL=plugsky-lite
OLLAMA_HOST=
OLLAMA_MODEL=
# Cadence max des appels Mistral (requêtes/s, 0 = illimitée)
LLM_REQUESTS_PER_SECOND=1
ADMIN_PASSWORD=admin
REDIS_ENABLED=false
REDIS_URL=
MODEL_AUTO_DOWNLOAD=true
# Modèle d'embedding quantifié int8 (~118 Mo) ; false = fp32 (~470 Mo)
MODEL_QUANTIZED=true
# Threads ONNX Runtime par inférence (moins = moins de RAM)
ONNX_THREADS=2
