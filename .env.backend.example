ENV=production
PORT=8080
DATABASE_URL=postgresql://user:password@db:5432/ask_rules
# LLM principal : API compatible OpenAI (llama.cpp, Mistral, Ollama…)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Cadence max (requêtes/s, 0 = illimitée)
LLM_REQUESTS_PER_SECOND=0
# Endpoint de santé d'un LLM pouvant être mis en veille (llama.cpp : /health)
LLM_HEALTH_URL=
LLM_WAKE_TIMEOUT_SECONDS=300
# LLM de secours : utilisé si le principal échoue (quota, panne, délai)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_TIMEOUT_SECONDS=60
LLM_FALLBACK_REQUESTS_PER_SECOND=0
ADMIN_PASSWORD=admin
# Questions max par minute et par IP (0 = illimité)
ASK_RATE_LIMIT_PER_MINUTE=10
REDIS_ENABLED=false
REDIS_URL=
MODEL_AUTO_DOWNLOAD=true
# Modèle d'embedding quantifié int8 (~118 Mo) ; false = fp32 (~470 Mo)
MODEL_QUANTIZED=true
# Threads ONNX Runtime par inférence (moins = moins de RAM)
ONNX_THREADS=2
