# syntax=docker/dockerfile:1

ARG ONNX_VERSION=1.20.0

FROM docker.io/library/golang:1.26-trixie AS builder
ARG ONNX_VERSION
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
    "https://github.com/microsoft/onnxruntime/releases/download/v${ONNX_VERSION}/onnxruntime-linux-x64-${ONNX_VERSION}.tgz" \
    -o /tmp/ort.tgz \
    && tar -xzf /tmp/ort.tgz -C /tmp \
    && cp /tmp/onnxruntime-linux-x64-${ONNX_VERSION}/lib/libonnxruntime.so.${ONNX_VERSION} \
          /usr/local/lib/libonnxruntime.so \
    && ldconfig \
    && rm -rf /tmp/ort*

COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download

COPY server ./server

RUN cd server && CGO_ENABLED=1 go build -ldflags="-w -s" -o /ask-rules-server ./cmd/server

# Modèle d'embedding intégré à l'image : sinon il est téléchargé à chaque
# démarrage à froid (avant que le serveur n'écoute), ce qui retarde le réveil.
COPY scripts/download-model.sh ./scripts/download-model.sh
RUN bash scripts/download-model.sh /models/multilingual-e5-small

FROM docker.io/library/debian:trixie-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    ca-certificates \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/libonnxruntime.so /usr/local/lib/libonnxruntime.so
RUN ldconfig

COPY --from=builder /ask-rules-server ./ask-rules-server
COPY --from=builder /models ./models
COPY scripts/download-model.sh /app/scripts/download-model.sh
COPY scripts/ensure-model.sh /app/scripts/ensure-model.sh
RUN chmod +x /app/scripts/download-model.sh /app/scripts/ensure-model.sh \
    && mkdir -p uploads models

ENV ENV=production \
    PORT=8080 \
    MODEL_PATH=/app/models/multilingual-e5-small \
    MODEL_AUTO_DOWNLOAD=true \
    UPLOADS_DIR=/app/uploads \
    LD_LIBRARY_PATH=/usr/local/lib

EXPOSE 8080

CMD ["/app/scripts/ensure-model.sh"]
