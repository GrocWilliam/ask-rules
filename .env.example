ENV=

# ── Configuration serveur ─────────────────────────────────────
PORT=8080
ADMIN_PASSWORD=

# ── Base de données ────────────────────────────────────────────
DATABASE_URL=postgresql://

# ── Répertoire uploads ─────────────────────────────────────────
UPLOADS_DIR=uploads

# ── Redis (optionnel) ──────────────────────────────────────────
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

# ── LLM ────────────────────────────────────────────────────────
# Toute API compatible OpenAI (POST <BASE_URL>/chat/completions).
# Exemples de LLM_BASE_URL :
#   llama.cpp (llama-server)  http://localhost:8080/v1
#   llama.cpp sur Railway     http://<service>.railway.internal:<port>/v1
#   Mistral                   https://api.mistral.ai/v1   (offre gratuite : 1 req/s)
#   Plugsky                   https://plugsky.com/v1
#   Ollama                    http://localhost:11434/v1
# API_KEY et MODEL sont optionnels pour llama.cpp (modèle chargé au démarrage).

# Principal
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_TIMEOUT_SECONDS=60
# LLM_REQUESTS_PER_SECOND=0
# LLM pouvant être mis en veille (llama.cpp sur Railway) : endpoint de santé.
# S'il ne répond pas, réveil en arrière-plan et question envoyée au secours.
# LLM_HEALTH_URL=http://<service>.railway.internal:<port>/health
# LLM_WAKE_TIMEOUT_SECONDS=300

# Secours : utilisé si le principal échoue (quota, panne, délai dépassé)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# LLM_FALLBACK_TIMEOUT_SECONDS=60
# LLM_FALLBACK_REQUESTS_PER_SECOND=0

# ── Modèle d'embeddings ONNX ───────────────────────────────────
MODEL_PATH=models/multilingual-e5-small/

# ── Autres ─────────────────────────────────────────────────────
NODE_TLS_REJECT_UNAUTHORIZED=0

