ENV=

# ── Configuration serveur ─────────────────────────────────────
PORT=8080
ADMIN_PASSWORD=

# ── Base de données ────────────────────────────────────────────
DATABASE_URL=postgresql://

# ── Répertoire uploads ─────────────────────────────────────────
UPLOADS_DIR=uploads

# ── Redis (optionnel) ──────────────────────────────────────────
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

# ── LLM Provider ───────────────────────────────────────────────
# Options: mistral (+ plugsky en secours), ollama
LLM_PROVIDER=mistral

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Plugsky (secours si Mistral échoue : quota atteint, panne)
# Clé API Plugsky (offre gratuite : plugsky-micro, plugsky-lite) : https://plugsky.com/
PLUGSKY_API_KEY=
PLUGSKY_MODEL=plugsky-lite
# PLUGSKY_BASE_URL=https://plugsky.com/v1

# Ollama (alternative locale)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# ── Modèle d'embeddings ONNX ───────────────────────────────────
MODEL_PATH=models/multilingual-e5-small/

# ── Autres ─────────────────────────────────────────────────────
NODE_TLS_REJECT_UNAUTHORIZED=0

