{
  "name": "reglomatic",
  "version": "1.0.1",
  "description": "PoC - Analyse de règles de jeu de société en français avec NLP",
  "main": "dist/index.js",
  "scripts": {
    "dev:front": "vite dev",
    "dev:back": "cd server && air",
    "build:web": "vite build",
    "build:go": "cd server && go build -o ask-rules-server .",
    "download:model": "scripts/download-model.sh",
    "build:all": "[ -f models/multilingual-e5-small/onnx/model.onnx ] || pnpm run download:model && pnpm run build:web && pnpm run build:go",
    "start": "cd server && ./ask-rules-server",
    "lint": "eslint . && svelte-check",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "nlp",
    "jeu-de-societe",
    "french",
    "board-game",
    "analyse",
    "llm",
    "ia"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.53.0",
    "dotenv": "17.3.1",
    "marked": "^17.0.3",
    "svelte": "5.53.3"
  },
  "devDependencies": {
    "@types/marked": "^6.0.0",
    "@types/node": "22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-plugin-svelte": "^3.15.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte-check": "4.4.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "6.4.1"
  }
}